    <file alias="NixStorePage.qml">NixStorePage.qml</file>
    <file alias="DeviceInfoPage.qml">DeviceInfoPage.qml</file>
    <file alias="BrowserPage.qml">BrowserPage.qml</file>
    <file alias="BrowserEngineWeb.qml">BrowserEngineWeb.qml</file>
    <file alias="BrowserEngineCef.qml">BrowserEngineCef.qml</file>
    <file alias="BrowserEnginePage.qml">BrowserEnginePage.qml</file>
    <file alias="AboutPage.qml">AboutPage.qml</file>
    <file alias="VkPanel.qml">VkPanel.qml</file>
    <file alias="TransferPage.qml">TransferPage.qml</file>
    <file alias="AppsPage.qml">AppsPage.qml</file>
    <file alias="NotesPage.qml">NotesPage.qml</file>
