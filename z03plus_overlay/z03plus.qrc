    <file alias="Z03UltraPage.qml">Z03UltraPage.qml</file>
    <file alias="MaterialTile.qml">MaterialTile.qml</file>
    <file alias="ScreenTimeoutPage.qml">ScreenTimeoutPage.qml</file>
    <file alias="StoragePage.qml">StoragePage.qml</file>
    <file alias="MusicPage.qml">MusicPage.qml</file>
    <file alias="RecorderPage.qml">RecorderPage.qml</file>
