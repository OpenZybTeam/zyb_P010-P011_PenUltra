<RCC>
  <qresource prefix="/">
    <file alias="main.qml">main.qml</file>
  </qresource>
  <qresource prefix="/ZybQmlFiles/ZybSet">
    <file alias="SetMainPage.qml">SetMainPage.qml</file>
    <file alias="Z03UltraPage.qml">Z03UltraPage.qml</file>
    <file alias="MaterialTile.qml">MaterialTile.qml</file>
    <file alias="ScreenTimeoutPage.qml">ScreenTimeoutPage.qml</file>
    <file alias="StoragePage.qml">StoragePage.qml</file>
    <file alias="MusicPage.qml">MusicPage.qml</file>
    <file alias="RecorderPage.qml">RecorderPage.qml</file>
    <file alias="ShellPage.qml">ShellPage.qml</file>
    <file alias="NixStorePage.qml">NixStorePage.qml</file>
    <file alias="DeviceInfoPage.qml">DeviceInfoPage.qml</file>
    <file alias="BrowserPage.qml">BrowserPage.qml</file>
    <file alias="AboutPage.qml">AboutPage.qml</file>
    <file alias="TransferPage.qml">TransferPage.qml</file>
    <file alias="AppsPage.qml">AppsPage.qml</file>
    <file alias="NotesPage.qml">NotesPage.qml</file>
    <file alias="SystemPage.qml">SystemPage.qml</file>
    <!-- File manager and text reader are embedded in Z03UltraPage.qml. -->
  </qresource>
</RCC>
